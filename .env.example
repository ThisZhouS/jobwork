# 复制成 .env 再填真实值；.env 不要提交到版本库
#
# 天眼查开放平台 token（登录 open.tianyancha.com 后在「个人中心-数据中心」拿）
TIANYANCHA_TOKEN=
# 可选：接口默认走官方网关，一般不用改
# TIANYANCHA_BASE_URL=https://open.api.tianyancha.com
# TIANYANCHA_QPS_DELAY=0.35
# TIANYANCHA_MAX_RETRIES=3
# TIANYANCHA_TIMEOUT=20

# 火山方舟（向量化）
ARK_API_KEY=
# 本账号可用端点是 /api/plan/v3，官方 /api/v3 会 401
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# ARK_MODEL=doubao-embedding-vision-250328

# 火山方舟（图片生成，仅用于 UI 概念图/图标，不进生产代码）
ARK_IMAGE_KEY=
# ARK_IMAGE_MODEL=doubao-seedream-5.0-pro

# PostgreSQL（也可用 .state/pg_password.txt）
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=boss_jobs
PGPASSWORD=
