# 运行期状态：登录态 / Cookie 快照，含敏感信息
.state/
# 凭据：天眼查 token、Ark key、数据库密码（模板见 .env.example）
.env
.env.*
!.env.example
# 任何位置的密钥/证书文件
*.pem
*.key
*.pfx
ark_key.txt
ark_image_key.txt
tyc_token.txt
pg_password.txt
storage_state.json
# 本地覆盖配置（可能被填进真实 token）
config/*.local.json
config/*.secret.json
# 抓取结果
output/
# 日志与临时文件
*.log
__pycache__/
*.pyc

# 测试与工具缓存
.pytest_cache/
.ruff_cache/
.coverage
.venv/
*.egg-info/
pytest.xml
# Qoder 本地检索索引与 repowiki 缓存
.qoder/

# 桌面端依赖与构建产物
desktop/node_modules/
desktop/dist/
desktop/dist*/
desktop/out/

# 本地技术文档与界面截图（不发布）
docs/
